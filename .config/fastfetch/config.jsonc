{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  󰅂  ",
    "color": {
      "separator": "38;2;146;131;116"     // #928374 (Gray)
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;216;166;87",        // #d8a657 (Yellow)
        "at": "38;2;146;131;116",          // #928374 (Gray)
        "host": "38;2;169;182;101"         // #a9b665 (Green)
      }
    },
    {
      "type": "custom",
      "format": "───────────────────────",
      "outputColor": "38;2;146;131;116"    // #928374 (Gray)
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "38;2;137;180;130"       // #89b482 (Aqua)
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "38;2;125;174;163"       // #7daea3 (Blue)
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "38;2;169;182;101"       // #a9b665 (Green)
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "38;2;216;166;87"        // #d8a657 (Yellow)
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "38;2;211;134;155"       // #d3869b (Purple)
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "38;2;137;180;130"       // #89b482 (Aqua)
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal",
      "keyColor": "38;2;231;138;78"        // #e78a4e (Orange)
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "38;2;234;105;98"        // #ea6962 (Red)
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "38;2;216;166;87"        // #d8a657 (Yellow)
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "38;2;169;182;101"       // #a9b665 (Green)
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
